name: Build Voxy Android

# Voxy (1.21.11 branch, pinned) + Android/GLES patch -> one jar.
# For personal use only: Voxy is "All Rights Reserved", do not share the jar this makes.
# Put THIS ONE FILE at .github/workflows/voxy-android.yml in a PRIVATE repo. It builds on push,
# or press "Run workflow". The jar appears under Releases (and as a build artifact).

on:
  workflow_dispatch:
  push:
    paths:
      - '.github/workflows/voxy-android.yml'

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Get Voxy source (pinned commit of the 1.21.11 branch)
        run: |
          git clone --quiet https://github.com/MCRcortex/voxy.git voxy-src
          cd voxy-src
          git checkout --quiet 59b62bee821518e06612e1d5c2c58c487bda761d
          git log -1 --oneline

